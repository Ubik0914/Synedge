# ============================================================
# Synedge 環境変数サンプル（実際の値はコミットしない）
#   web    : apps/web（Vercel）
#   worker : apps/worker（Cloud Run：Pub/Sub受信・watch更新・定期照合）
#   mcp    : apps/mcp（Cloud Run またはローカル stdio）
# ============================================================

# ---- 共通（web / worker / mcp）----
# Supabase の Postgres 接続文字列（サーバー専用。Transaction pooler :6543 推奨）
#   navy と同じプロジェクトを共用する。Synedge のテーブルは synedge スキーマに置く
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
# OAuthトークン暗号化鍵（AES-256-GCM、32バイトをbase64）。"id:鍵" をカンマ区切り、先頭が現行鍵
#   生成: node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEYS=k1:REPLACE_WITH_BASE64_32_BYTES
# Google Cloud の OAuth クライアント（ウェブアプリケーション）
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_ME
# Web アプリの公開URL（OAuth リダイレクトURIは ${APP_ORIGIN}/api/auth/google/callback）
APP_ORIGIN=https://synedge.example.com

# ---- web ----
# セッション署名鍵（32文字以上のランダム文字列）
#   生成: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=REPLACE_WITH_RANDOM_48_BYTES
# ログインを許可する Google アカウント（カンマ区切り）。空なら誰もログインできない
ALLOWED_EMAILS=you@gmail.com
# Gmail watch の通知先 Pub/Sub トピック（未設定なら新着通知は動かない）
GMAIL_PUBSUB_TOPIC=projects/YOUR_PROJECT/topics/synedge-gmail
# 設定画面の「テスト通知」に使う FCM サービスアカウントJSON（JSON文字列 または base64）
FCM_SERVICE_ACCOUNT_JSON=
# Android アプリのカスタムURLスキーム（AndroidManifest と一致させる）
ANDROID_APP_SCHEME=synedge

# ---- worker ----
# PORT=8080
# GMAIL_PUBSUB_TOPIC=（web と同じ）
# FCM 認証：Cloud Run ではサービスアカウント（鍵ファイル不要）を推奨
FCM_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
# FCM_SERVICE_ACCOUNT_JSON=（鍵ファイルを使う場合のみ）
# Pub/Sub push と Cloud Scheduler の OIDC 検証（audience は worker のURL、SAは呼び出し元）
PUBSUB_AUDIENCE=https://synedge-worker-xxxxx-an.a.run.app
PUBSUB_SERVICE_ACCOUNTS=synedge-pubsub-push@YOUR_PROJECT.iam.gserviceaccount.com
SCHEDULER_AUDIENCE=https://synedge-worker-xxxxx-an.a.run.app
SCHEDULER_SERVICE_ACCOUNTS=synedge-scheduler@YOUR_PROJECT.iam.gserviceaccount.com

# ---- mcp ----
# PORT=8787
# ALLOWED_EMAILS=（web と同じ）
# ブラウザから接続を許可する Origin（通常は空のまま）
MCP_ALLOWED_ORIGINS=
# stdio 起動時のみ：設定画面で発行した MCP トークン
SYNEDGE_MCP_TOKEN=

# ---- ローカル開発・テスト ----
# Postgres 実機テスト（スーパーユーザー権限の接続先。テストごとに一時DBを作成・削除する）
DATABASE_URL_TEST=postgres://synedge:synedge@localhost:5432/synedge_test
# Android アプリが開く Web の URL（cap sync 時に読み込む）
SYNEDGE_WEB_URL=https://synedge.example.com
